package ap

import "core:slice"
import "core:testing"

// Fixtures from protoc --encode against librespot's authentication.proto and
// keyexchange.proto. All token and credential strings here are fake.
@(test)
login_token_matches_protoc :: proc(t: ^testing.T) {
	got := client_login_token("test-token", "device")
	defer delete(got)
	want := []u8 {
		0x52,
		0x10,
		0xa0,
		0x01,
		0x03,
		0xf2,
		0x01,
		0x0a,
		0x74,
		0x65,
		0x73,
		0x74,
		0x2d,
		0x74,
		0x6f,
		0x6b,
		0x65,
		0x6e,
		0x92,
		0x03,
		0x1b,
		0x50,
		0x02,
		0xe0,
		0x03,
		0x05,
		0xd2,
		0x05,
		0x0a,
		0x73,
		0x70,
		0x6f,
		0x74,
		0x69,
		0x2d,
		0x6f,
		0x64,
		0x69,
		0x6e,
		0xa2,
		0x06,
		0x06,
		0x64,
		0x65,
		0x76,
		0x69,
		0x63,
		0x65,
		0xb2,
		0x04,
		0x09,
		0x73,
		0x70,
		0x6f,
		0x74,
		0x69,
		0x20,
		0x30,
		0x2e,
		0x31,
	}
	testing.expect(t, slice.equal(got[:], want))
	testing.expect(t, client_login_token("", "device") == nil)
}

@(test)
login_reply_matches_protoc :: proc(t: ^testing.T) {
	welcome := []u8 {
		0x52,
		0x07,
		0x65,
		0x78,
		0x61,
		0x6d,
		0x70,
		0x6c,
		0x65,
		0xa0,
		0x01,
		0x00,
		0xc8,
		0x01,
		0x00,
		0xf0,
		0x01,
		0x01,
		0xc2,
		0x02,
		0x0b,
		0x74,
		0x65,
		0x73,
		0x74,
		0x2d,
		0x73,
		0x65,
		0x63,
		0x72,
		0x65,
		0x74,
	}
	name, _, kind := parse_login_reply(0xac, welcome)
	testing.expect(t, kind == .Welcome && name == "example")
	code: u64
	_, code, kind = parse_login_reply(0xad, []u8{0x50, 0x0c})
	testing.expect(t, kind == .Failure && code == 12)
	_, _, kind = parse_login_reply(0xac, welcome[:len(welcome) - 1])
	testing.expect(t, kind == .Invalid)
	_, _, kind = parse_login_reply(0xab, welcome)
	testing.expect(t, kind == .Invalid)
}
