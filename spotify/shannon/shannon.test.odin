package shannon

import "core:slice"
import "core:testing"

@(test)
spotify_packets_match_rust_reference :: proc(t: ^testing.T) {
	// Vectors generated by the shannon 0.2 crate used in librespot.
	key: [32]u8
	for i in 0 ..< len(key) {key[i] = u8(i)}
	plain1 := [8]u8{0xab, 0, 5, 1, 2, 3, 4, 5}
	plain2 := [9]u8{0xac, 0, 6, 10, 20, 30, 40, 50, 60}
	want1 := [8]u8{0x61, 0x7d, 0xec, 0x2a, 0x9c, 0xcd, 0x37, 0x45}
	want2 := [9]u8{0x17, 0x97, 0x20, 0xa5, 0xfc, 0x2f, 0xdf, 0x8b, 0xb2}
	mac1 := [4]u8{0xa5, 0x68, 0x60, 0x3b}
	mac2 := [4]u8{0x88, 0xb0, 0x84, 0xf1}
	for nonce_value in 0 ..< 2 {
		cipher := new(key[:])
		nonce(&cipher, u32(nonce_value))
		if nonce_value == 0 {
			encrypt(&cipher, plain1[:])
			testing.expect(t, slice.equal(plain1[:], want1[:]))
			tag := finish(&cipher)
			testing.expect(t, slice.equal(tag[:], mac1[:]))
		} else {
			encrypt(&cipher, plain2[:])
			testing.expect(t, slice.equal(plain2[:], want2[:]))
			tag := finish(&cipher)
			testing.expect(t, slice.equal(tag[:], mac2[:]))
		}
	}
}
