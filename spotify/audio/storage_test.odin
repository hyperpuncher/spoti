package audio

import "core:testing"

@(test)
storage_response_selects_trusted_https_cdn :: proc(t: ^testing.T) {
	// protoc --encode=spotify.download.proto.StorageResolveResponse.
	payload := []u8 {
		0x12,
		0x35,
		0x68,
		0x74,
		0x74,
		0x70,
		0x73,
		0x3a,
		0x2f,
		0x2f,
		0x61,
		0x75,
		0x64,
		0x69,
		0x6f,
		0x2d,
		0x63,
		0x66,
		0x2e,
		0x73,
		0x70,
		0x6f,
		0x74,
		0x69,
		0x66,
		0x79,
		0x63,
		0x64,
		0x6e,
		0x2e,
		0x63,
		0x6f,
		0x6d,
		0x2f,
		0x61,
		0x75,
		0x64,
		0x69,
		0x6f,
		0x2f,
		0x74,
		0x65,
		0x73,
		0x74,
		0x3f,
		0x76,
		0x65,
		0x72,
		0x69,
		0x66,
		0x79,
		0x3d,
		0x61,
		0x62,
		0x63,
		0x22,
		0x14,
		0x61,
		0x62,
		0x63,
		0x64,
		0x65,
		0x66,
		0x67,
		0x68,
		0x69,
		0x6a,
		0x6b,
		0x6c,
		0x6d,
		0x6e,
		0x6f,
		0x70,
		0x71,
		0x72,
		0x73,
		0x74,
	}
	file: [20]u8
	for i in 0 ..< 20 {file[i] = u8(i + 'a')}
	address, ok := cdn_url(payload, file)
	testing.expect(t, ok && address == "https://audio-cf.spotifycdn.com/audio/test?verify=abc")
	file[0] = 'z'
	_, ok = cdn_url(payload, file)
	testing.expect(t, !ok)
	_, ok = cdn_url(payload[:len(payload) - 1], file)
	testing.expect(t, !ok)
	testing.expect(t, !trusted_cdn("https://audio-cf.spotifycdn.com.evil.test/audio"))
	testing.expect(t, !trusted_cdn("http://audio-cf.spotifycdn.com/audio"))
	testing.expect(t, trusted_cdn("https://audio4-fa.scdn.co/audio/test"))
}
